{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/batches",
      "regex": "^/batches(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/batches(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/ledger",
      "regex": "^/ledger(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ledger(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/medicines",
      "regex": "^/medicines(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/medicines(?:/)?$"
    },
    {
      "page": "/patients",
      "regex": "^/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/patients(?:/)?$"
    },
    {
      "page": "/prescriptions",
      "regex": "^/prescriptions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/prescriptions(?:/)?$"
    },
    {
      "page": "/stakeholders",
      "regex": "^/stakeholders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/stakeholders(?:/)?$"
    },
    {
      "page": "/verification",
      "regex": "^/verification(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/verification(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}